#!/usr/bin/env python3
"""Builds gpui-pre-overlay/: the published gpui-pre crates with this branch's changes.

gpui-component depends on the `gpui-pre-*` snapshots on crates.io, which are
Zed's crates renamed, re-versioned and lightly patched. This script downloads
the snapshot of each crate we change, checks that it was cut from the commit
this branch starts at, and applies this branch's changes to its sources. An
application then replaces the crates.io packages with these through
`[patch.crates-io]`, and every other gpui-pre crate stays the published one.

Usage: script/dsc-gpui-pre-package <gpui-pre version> [base ref]
       (run from the repository root; base defaults to gpui-texture-surfaces)
"""

import io
import shutil
import subprocess
import sys
import tarfile
import tomllib
import urllib.request
from pathlib import Path

CRATES = {
    "gpui-pre": "gpui",
    "gpui-pre-wgpu": "gpui_wgpu",
    "gpui-pre-linux": "gpui_linux",
}
OVERLAY = Path("gpui-pre-overlay")


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], check=True, capture_output=True, text=True
    ).stdout


def download(name: str, version: str) -> tarfile.TarFile:
    url = f"https://crates.io/api/v1/crates/{name}/{version}/download"
    request = urllib.request.Request(url, headers={"User-Agent": "dsc-gpui-pre-package"})
    with urllib.request.urlopen(request) as response:
        return tarfile.open(fileobj=io.BytesIO(response.read()), mode="r:gz")


def main() -> None:
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__)
    version = sys.argv[1]
    feature = sys.argv[2] if len(sys.argv) == 3 else "gpui-texture-surfaces"

    shutil.rmtree(OVERLAY, ignore_errors=True)
    OVERLAY.mkdir()
    base = None
    for name, zed_crate in CRATES.items():
        target = OVERLAY / name
        with download(name, version) as archive:
            archive.extractall(OVERLAY, filter="data")
        (OVERLAY / f"{name}-{version}").rename(target)

        manifest_path = target / "Cargo.toml"
        manifest = tomllib.loads(manifest_path.read_text())
        rev = manifest["package"]["metadata"]["gpui-pre"]["zed-rev"]
        if base is None:
            base = rev
        elif rev != base:
            sys.exit(f"{name} {version} is cut from zed@{rev}, the others from zed@{base}")

        diff = git("diff", "--binary", f"{base}..{feature}", "--", f"crates/{zed_crate}/src")
        if diff:
            subprocess.run(
                ["git", "apply", "-p3", f"--directory={target}", "-"],
                input=diff,
                text=True,
                check=True,
            )
        # A workspace of its own keeps the package out of Zed's workspace when
        # Cargo loads it from this repository.
        with manifest_path.open("a") as manifest_file:
            manifest_file.write("\n[workspace]\n")
        (target / "Cargo.lock").unlink(missing_ok=True)

    if subprocess.run(["git", "merge-base", "--is-ancestor", base, feature]).returncode:
        sys.exit(f"{feature} does not start from zed@{base}, the commit gpui-pre {version} is cut from")
    (OVERLAY / "README.md").write_text(
        f"Generated by `script/dsc-gpui-pre-package {version}` from `{feature}` "
        f"(base zed@{base[:10]}). Do not edit; change `{feature}` and regenerate.\n"
    )
    print(f"gpui-pre {version} + {feature} written to {OVERLAY}/")


if __name__ == "__main__":
    main()
